MATCH (n:Agent) WHERE NOT (n:Entity) SET n:Entity;
MATCH (n:Activity) WHERE NOT (n:Occurrence) SET n:Occurrence;
MATCH (n:Identifier) WHERE NOT (n:Entity) SET n:Entity;
