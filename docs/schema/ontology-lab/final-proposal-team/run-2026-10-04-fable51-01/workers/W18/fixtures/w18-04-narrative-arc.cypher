MATCH (a:NarrativeArc {uid: 'hu:narrative-arc:rezdiffra-path-v1'}), (b:Product {uid: 'hu:product:rezdiffra'}) MERGE (a)-[r:ARC_ABOUT]->(b);
MATCH (a:NarrativeArc {uid: 'hu:narrative-arc:rezdiffra-path-v1'}), (b:Event {uid: 'hu:event:maestro-nash-topline-2022-12-19'}) MERGE (a)-[r:ARC_INCLUDES_EVENT]->(b) SET r += {orderIndex: 1};
