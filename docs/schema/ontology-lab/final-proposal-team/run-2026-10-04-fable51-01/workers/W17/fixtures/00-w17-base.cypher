MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:zocor-7-ccb-intervention'})
  ON CREATE SET n.id = 'zocor-7-ccb-intervention', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8f55d5de-5a4f-4a39-8c84-c53976dd6af9', n.selectorKind = 'TEXT_QUOTE', n.section = '7.1 Drug Interactions: Amiodarone, Dronedarone, Ranolazine, or Calcium Channel Blockers', n.exact = 'For patients taking verapamil, diltiazem, or dronedarone, do not exceed ZOCOR 10 mg daily.', n.quoteHash = 'sha256:6053a5a9f15b99dfbfadca4679d8f1e20e6e453d82d03432464cb25cfdaccd14', n.normalizationVersion = 'NFC-WS1';
