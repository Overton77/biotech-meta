MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:zocor-7-niacin-impact'})
  ON CREATE SET n.id = 'zocor-7-niacin-impact', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8f55d5de-5a4f-4a39-8c84-c53976dd6af9', n.selectorKind = 'TEXT_QUOTE', n.section = '7.1 Drug Interactions: Niacin (Clinical Impact)', n.exact = 'Cases of myopathy and rhabdomyolysis have been observed with concomitant use of lipid modifying dosages of niacin-containing products (≥1 gram/day niacin) with ZOCOR. The risk of myopathy is greater in Chinese patients.', n.quoteHash = 'sha256:4060f3c2701e874741541d7a11d2b948f55efb8715f815b9291bf6f69b7b02ba', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:dailymed-zocor-8f55d5de-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:zocor-7-niacin-impact'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:zocor-7-niacin-intervention'})
  ON CREATE SET n.id = 'zocor-7-niacin-intervention', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8f55d5de-5a4f-4a39-8c84-c53976dd6af9', n.selectorKind = 'TEXT_QUOTE', n.section = '7.1 Drug Interactions: Niacin (Intervention)', n.exact = 'Concomitant use of ZOCOR with lipid-modifying dosages of niacin is not recommended in Chinese patients [see Use in Specific Populations (8.8)]. For non-Chinese patients, consider if the benefit of using lipid-modifying doses of niacin concomitantly with ZOCOR outweighs the increased risk of myopathy and rhabdomyolysis.', n.quoteHash = 'sha256:a40e2eae2f8c40c1c29fce646ad6cdff423110064b43e3fb6c191672530ac69c', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:dailymed-zocor-8f55d5de-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:zocor-7-niacin-intervention'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:zocor-7-grapefruit'})
  ON CREATE SET n.id = 'zocor-7-grapefruit', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8f55d5de-5a4f-4a39-8c84-c53976dd6af9', n.selectorKind = 'TEXT_QUOTE', n.section = '7.1 Drug Interactions: Grapefruit Juice', n.exact = 'Grapefruit juice can raise the plasma levels of simvastatin and may increase the risk of myopathy and rhabdomyolysis. Avoid grapefruit juice when taking ZOCOR.', n.quoteHash = 'sha256:ae572c6aff44724ba86f9eabb91ba833fe6ab9766a96ba600a3689a46846a3fc', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:dailymed-zocor-8f55d5de-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:zocor-7-grapefruit'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
