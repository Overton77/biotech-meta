MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:fda-dsc-2021-high-risk-exception'})
  ON CREATE SET n.id = 'fda-dsc-2021-high-risk-exception', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.fda.gov/drugs/drug-safety-and-availability/fda-requests-removal-strongest-warning-against-using-cholesterol-lowering-statins-during-pregnancy', n.selectorKind = 'TEXT_QUOTE', n.section = 'What is FDA doing?', n.exact = 'Because the benefits of statins may include prevention of serious or potentially fatal events in a small group of very high-risk pregnant patients, contraindicating these drugs in all pregnant women is not appropriate.', n.quoteHash = 'sha256:312963b1f0c4fa9a741b9d2a3487adf23e380b62c0dbd7da8fd01b1ab70c0412', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:fda-dsc-statins-pregnancy-2021-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:fda-dsc-2021-high-risk-exception'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:fda-dsc-2021-stop-when-pregnant'})
  ON CREATE SET n.id = 'fda-dsc-2021-stop-when-pregnant', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.fda.gov/drugs/drug-safety-and-availability/fda-requests-removal-strongest-warning-against-using-cholesterol-lowering-statins-during-pregnancy', n.selectorKind = 'TEXT_QUOTE', n.section = 'What safety information is FDA announcing', n.exact = 'Despite the change, most patients should stop statins once they learn they are pregnant.', n.quoteHash = 'sha256:b6695062026dcb6438099fbfbb2bf59a0bcb6063b66f03a14b11c4a8b977831d', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:fda-dsc-statins-pregnancy-2021-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:fda-dsc-2021-stop-when-pregnant'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:fda-dsc-2021-breastfeeding'})
  ON CREATE SET n.id = 'fda-dsc-2021-breastfeeding', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.fda.gov/drugs/drug-safety-and-availability/fda-requests-removal-strongest-warning-against-using-cholesterol-lowering-statins-during-pregnancy', n.selectorKind = 'TEXT_QUOTE', n.section = 'What safety information is FDA announcing', n.exact = 'Patients should not breastfeed when taking a statin because the medicine may pass into breast milk and pose a risk to the baby.', n.quoteHash = 'sha256:be5cf77c54b5f43e87666d51e842dd6bfa4020c4b0df97407bdf220f0db816ef', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:fda-dsc-statins-pregnancy-2021-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:fda-dsc-2021-breastfeeding'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:fda-aems-2024q3-lenvatinib-row'})
  ON CREATE SET n.id = 'fda-aems-2024q3-lenvatinib-row', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.fda.gov/drugs/fda-adverse-event-monitoring-system-aems/july-september-2024-new-safety-information-or-potential-signals-serious-risks-identified-fda-adverse', n.selectorKind = 'TEXT_QUOTE', n.section = 'Table row: Lenvima (lenvatinib) capsules / Nexavar (sorafenib) tablets', n.exact = 'Tumor lysis syndrome | Updated FDA determined that no action was necessary at the time based on available information.', n.quoteHash = 'sha256:d60cebe70084d36e69ce2f1404e3e81a21698fedbc5174a5d4c5047239dfe3de', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:fda-aems-2024q3-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:fda-aems-2024q3-lenvatinib-row'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:fda-aems-2024q3-daptomycin-row'})
  ON CREATE SET n.id = 'fda-aems-2024q3-daptomycin-row', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.fda.gov/drugs/fda-adverse-event-monitoring-system-aems/july-september-2024-new-safety-information-or-potential-signals-serious-risks-identified-fda-adverse', n.selectorKind = 'TEXT_QUOTE', n.section = 'Table row: Cubicin (daptomycin for injection)', n.exact = 'Hyperkalemia | Updated The “Adverse Reactions” section of the labeling was updated in April and May 2025 to include information about hyperkalemia.', n.quoteHash = 'sha256:413a92d2828b86a255af055935e2a8df374fe2abb436e17ad2a9c799ed595e9b', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:fda-aems-2024q3-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:fda-aems-2024q3-daptomycin-row'})
