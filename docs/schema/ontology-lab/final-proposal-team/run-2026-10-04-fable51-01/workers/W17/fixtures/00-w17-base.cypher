MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:afp-2017-kava'})
  ON CREATE SET n.id = 'afp-2017-kava', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.aafp.org/pubs/afp/issues/2017/0715/p101.html', n.selectorKind = 'TEXT_QUOTE', n.section = 'Kava kava', n.exact = 'Additionally, the results of two in vitro studies suggest the potential to inhibit CYP2C9 and CYP2C19, which are involved in the metabolism of many nonsteroidal anti-inflammatory drugs, angiotensin receptor blockers, glipizide (Glucotrol), glyburide, rosiglitazone (Avandia), valproic acid (Depakene), warfarin, proton pump inhibitors, phenytoin (Dilantin), and clopidogrel (Plavix). Patients taking medications metabolized by CYP2C9 or CYP2C19 should be closely monitored for clinical adverse effects and laboratory abnormalities (e.g., glucose level, A1C level, INR) or instructed not to use kava-containing supplements.', n.quoteHash = 'sha256:0afbd5be258b950a21a26ac4d4b88b54578f6238d8eef2ca0b0eaa8083833f60', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:aafp-afp-2017-0715-p101-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:afp-2017-kava'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:afp-2017-green-tea'})
  ON CREATE SET n.id = 'afp-2017-green-tea', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.aafp.org/pubs/afp/issues/2017/0715/p101.html', n.selectorKind = 'TEXT_QUOTE', n.section = 'Green tea', n.exact = 'However, green tea extract has been shown to increase simvastatin (Zocor) concentrations, which may be due to P-gp inhibition.', n.quoteHash = 'sha256:c94724eac9fb3c32275c8abd3988bb39c21d264f96a34e2b5e8f97edab98cf9e', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:aafp-afp-2017-0715-p101-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:afp-2017-green-tea'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:afp-2017-st-johns-wort'})
  ON CREATE SET n.id = 'afp-2017-st-johns-wort', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.aafp.org/pubs/afp/issues/2017/0715/p101.html', n.selectorKind = 'TEXT_QUOTE', n.section = 'St. John\'s wort', n.exact = 'Clinical studies have shown reductions in cyclosporine (Sandimmune), tacrolimus, warfarin, protease inhibitors, irinotecan (Camptosar), theophylline, digoxin, venlafaxine, and oral contraceptives. It is strongly recommended to avoid concurrent use of St. John\'s wort with over-the-counter and prescription medications.', n.quoteHash = 'sha256:22623b1cb9259b416b639ef6afca6348cd6d3297f31cbd20fe7993388734244d', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:aafp-afp-2017-0715-p101-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:afp-2017-st-johns-wort'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:afp-2017-sort-goldenseal-sjw'})
  ON CREATE SET n.id = 'afp-2017-sort-goldenseal-sjw', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.aafp.org/pubs/afp/issues/2017/0715/p101.html', n.selectorKind = 'TEXT_QUOTE', n.section = 'SORT: Key recommendations for practice', n.exact = 'Drug interactions with goldenseal and St. John\'s wort are highly likely, and clinicians should counsel patients to avoid concurrent use with over-the-counter or prescription medications. | C', n.quoteHash = 'sha256:c31ce5fd2f5e3b513b865fe587b8ca506acbbcb14704f2ef7efa3214c559e2ac', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:aafp-afp-2017-0715-p101-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:afp-2017-sort-goldenseal-sjw'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:afp-2017-american-ginseng'})
  ON CREATE SET n.id = 'afp-2017-american-ginseng', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://www.aafp.org/pubs/afp/issues/2017/0715/p101.html', n.selectorKind = 'TEXT_QUOTE', n.section = 'American ginseng', n.exact = 'Two human trials have demonstrated no effect of American ginseng on the human immunodeficiency virus (HIV) agents indinavir (Crixivan) and zidovudine (Retrovir).', n.quoteHash = 'sha256:9d67f81147daa211a3994d0d8ec3f6a71343363215a7bf900121a36e0a499cba', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:aafp-afp-2017-0715-p101-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:afp-2017-american-ginseng'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:ods-vitk-warfarin'})
  ON CREATE SET n.id = 'ods-vitk-warfarin', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://ods.od.nih.gov/factsheets/VitaminK-HealthProfessional/', n.selectorKind = 'TEXT_QUOTE', n.section = 'Interactions with Medications: Warfarin (Coumadin) and similar anticoagulants', n.exact = 'People taking warfarin and similar anticoagulants need to maintain a consistent intake of vitamin K from food and supplements because sudden changes in vitamin K intakes can increase or decrease the anticoagulant effect', n.quoteHash = 'sha256:963a6c8a7741aad2bf0903dfcb3149573112161518071aa7ec9d414d37ec668e', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:ods-vitamin-k-hp-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:ods-vitk-warfarin'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:pmc5701244-results-related-aes'})
  ON CREATE SET n.id = 'pmc5701244-results-related-aes', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5701244/', n.selectorKind = 'TEXT_QUOTE', n.section = 'Results: Adverse events', n.exact = 'There was one AE mild in intensity assessed as possibly related to the placebo product (pruritus), one AE mild in intensity assessed as possibly related to NRPT 1X (nausea), and five AEs (moderate fatigue, mild headache, moderate dyspepsia, moderate abdominal discomfort and diarrhea) reported by five participants in the NRPT 2X group (Table). Four of these AEs were assessed as possibly related to NRPT 2X, while one AE (diarrhea) was assessed as probably related to NRPT 2X.', n.quoteHash = 'sha256:d7f9886af60c24cece7cce41beca1e86d8f9f04eb1ca0d5f26512777a4a4ad57', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:pmc5701244-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:pmc5701244-results-related-aes'})
MERGE (a)-[r:HAS_LOCATOR]->(b);
