MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:pmc5701244-results-adverse-events'})
  ON CREATE SET n.id = 'pmc5701244-results-adverse-events', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5701244/', n.selectorKind = 'TEXT_QUOTE', n.section = 'Results: Adverse events', n.exact = 'All participants reporting AEs recovered and there were no serious AEs reported during this clinical study.', n.quoteHash = 'sha256:6961319fcc06c27b5d2f834b8fa153e1437ceef6284c26d80aadaa60a40f2943', n.normalizationVersion = 'NFC-WS1';
