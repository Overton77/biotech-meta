  ON CREATE SET n.id = 'pmc5701244-methods-safety-parameters', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5701244/', n.selectorKind = 'TEXT_QUOTE', n.section = 'Methods: Clinical trial', n.exact = 'Safety parameters measured included a standard clinical checkup, self-reported AEs', n.quoteHash = 'sha256:286009f08376947742036e9e9820978888f55a85a62d3e66c5d551c077474c99', n.normalizationVersion = 'NFC-WS1';
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:pmc5701244-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:pmc5701244-methods-safety-parameters'})
