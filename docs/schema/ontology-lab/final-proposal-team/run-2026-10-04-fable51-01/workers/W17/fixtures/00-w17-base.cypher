MERGE (n:SourceLocator:InformationArtifact {uid: 'hu:locator:zocor-2-5-verapamil'})
  ON CREATE SET n.id = 'zocor-2-5-verapamil', n.createdAt = datetime('2026-10-04T02:00:00Z'), n.privacyClass = 'PUBLIC', n.artifactType = 'SourceLocator', n.uri = 'https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=8f55d5de-5a4f-4a39-8c84-c53976dd6af9', n.selectorKind = 'TEXT_QUOTE', n.section = '2.5 Dosage modifications (highlights)', n.exact = 'Patients taking Verapamil, Diltiazem, or Dronedarone Do not exceed ZOCOR 10 mg once daily.', n.quoteHash = 'sha256:205ce935cb102ebb3e90e0b8734d11e0ad7dbf77f02943001700ac3b6709172f', n.normalizationVersion = 'NFC-WS1';
