SET tv.documentTextVersionId = 'hubermanlab-52-page-tavily-2026-10-04', tv.artifactType = 'DocumentTextVersion', tv.versionLabel = 'publisher-transcript-page-tavily-text', tv.source = 'tavily-extract (basic, text)',
    tv.text = 'David Sinclair:\nWell, I\'m always happy to tell you what I do and what my father does. My 82 -year-old father, we take a gram of NMN every day.\nAndrew Huberman:\nSo it\'s a gram of resveratrol and a gram of NMN.\nDavid Sinclair:\nRight.\nAndrew Huberman:\nOkay. A thousand milligrams.\nDavid Sinclair:\nNow another important point, which is I\'m not the same as everybody else. I have different microbiome, age, sex.',
    tv.textVersionHash = 'sha256:54f15992eab487f104503a219f39d8ad293ac31d067414db387f84674f238b66', tv.contentHash = 'sha256:54f15992eab487f104503a219f39d8ad293ac31d067414db387f84674f238b66', tv.languageCode = 'en', tv.observedAt = s.observedAt, tv.createdAt = datetime('2026-10-04T01:05:00Z'), tv.updatedAt = datetime('2026-10-04T01:05:00Z')
MERGE (d)-[:HAS_TEXT_VERSION]->(tv)
