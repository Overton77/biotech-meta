MATCH (d:Document {uid: 'hu:document:pmc-pmc11176364-html'}), (s:SourceSnapshot {uid: 'hu:snapshot:pmc11176364-html-tavily-2026-10-04'}), (act:Activity {uid: 'hu:activity:w20f04-extract-tavily'})
MERGE (tv:DocumentTextVersion:InformationArtifact {uid: 'hu:text-version:pmc11176364-html-tavily-2026-10-04'})
SET tv.documentTextVersionId = 'pmc11176364-html-tavily-2026-10-04', tv.artifactType = 'DocumentTextVersion', tv.versionLabel = 'pmc-html-tavily-extract-text', tv.source = 'tavily-extract (advanced, text)',
    tv.text = 'Resveratrol, a naturally occurring polyphenol, may increase SIRT1 affinity for NAD+17. Therefore, the NICotinamidE riboside with and without resveratrol to improve functioning in PAD (NICE) clinical trial tested the hypotheses that NR alone improves 6-min walk distance, compared to placebo, and that NR + resveratrol improves 6-min walk distance, compared to placebo, in people with PAD.\nHere we show that NR meaningfully improves 6-min walk, and resveratrol does not add benefit to NR alone in PAD.\n[...]\nPrimary outcomes\nCompared to placebo, NR improved 6-min walk by 17.6 meters (90% CI: + 1.77, +∞, P = 0.08) at 6-month follow-up, meeting the pre-specified criterion for statistical significance (Table 2 and Fig. 2A).',
    tv.textVersionHash = 'sha256:5c2913056613f2bbd9c81b617287182cdb9eb4188b1d249880c4294c7a7ae79a', tv.contentHash = 'sha256:5c2913056613f2bbd9c81b617287182cdb9eb4188b1d249880c4294c7a7ae79a', tv.languageCode = 'en', tv.observedAt = s.observedAt, tv.createdAt = datetime('2026-10-04T01:05:00Z'), tv.updatedAt = datetime('2026-10-04T01:05:00Z')
MERGE (d)-[:HAS_TEXT_VERSION]->(tv)
MERGE (tv)-[:TEXT_OF_SNAPSHOT]->(s)
MERGE (tv)-[:WAS_GENERATED_BY]->(act);
