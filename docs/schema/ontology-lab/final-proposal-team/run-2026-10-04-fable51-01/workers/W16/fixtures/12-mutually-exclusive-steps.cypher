// Q-W16-12: alternative sets in an edition (connected components over MUTUALLY_EXCLUSIVE_WITH), with each alternative's declared dose/duration.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)-[:DEPENDS_ON {dependencyKind: 'MUTUALLY_EXCLUSIVE_WITH'}]-(t:ProtocolStep)
WHERE (e)-[:HAS_PROTOCOL_STEP]->(t) AND s.stepKey < t.stepKey
OPTIONAL MATCH (s)-[us:USES]->() OPTIONAL MATCH (t)-[ut:USES]->()
RETURN s.stepKey AS alternativeA, t.stepKey AS alternativeB, coalesce(toString(us.quantity) + ' ' + us.unitCode, toString(s.durationMinutesMin) + ' min') AS a,
       coalesce(toString(ut.quantity) + ' ' + ut.unitCode, toString(t.durationMinutesMin) + ' min') AS b ORDER BY alternativeA;
