MATCH (a:ProtocolStep {uid: 'hu:protocol-step:blueprint-full-body-mri-annual-v1'}), (b:Constraint {uid: 'hu:constraint:blueprint-age-over-40'}) MERGE (a)-[r:HAS_CONSTRAINT]->(b) SET r += {constraintRole: 'APPLIES_WHEN', conditionGroup: 'g1', negated: false};
MATCH (a:ProtocolStep {uid: 'hu:protocol-step:blueprint-full-body-mri-annual-v1'}), (b:Constraint {uid: 'hu:constraint:blueprint-family-history-high-risk'}) MERGE (a)-[r:HAS_CONSTRAINT]->(b) SET r += {constraintRole: 'APPLIES_WHEN', conditionGroup: 'g1', negated: false};
MERGE (n:ProtocolStep:Entity {uid: 'hu:protocol-step:blueprint-neg-mole-check-annual-v1'}) SET n += {id: 'blueprint-neg-mole-check-annual-v1', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'ProtocolStep', stepKey: 'mole-check-annual', payloadHash: 'sha256:805d69d4549899b11fb86f035919a9295ca4e9ae457b2573c9949c235315ee82', name: 'NEG conditional step with no condition', stepKind: 'TEST', requirementLevel: 'CONDITIONAL', scheduleText: 'Mole check, annually', requirementBasis: 'STATED_BY_SOURCE'};
MERGE (n:ProtocolEdition:VersionedState {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}) SET n += {id: 'blueprint-observed-2026-10-04', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', stateType: 'ProtocolEdition', editionLabel: null, changeProvenance: 'SNAPSHOT_DIFF', payloadHash: 'sha256:86744da6a95ab3113ab3a339a39023c84461a6a066973223c970b46dc827eccd', payloadCanonicalizationVersion: 'W16-CANON-1', stepKeyAlignmentVersion: 'W16-STEPKEY-1'};
MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}), (b:ProtocolStep {uid: 'hu:protocol-step:blueprint-full-body-mri-annual-v1'}) MERGE (a)-[r:HAS_PROTOCOL_STEP]->(b) SET r += {orderIndex: 1, sectionLabel: 'Routine Measurement', sourceStepLabel: '2'};

// NEGATIVE (expected V-525p CONDITIONAL_STEP_WITHOUT_CONDITION): a CONDITIONAL step with no APPLIES_WHEN constraint (missing condition).
MERGE (n:ProtocolEdition:VersionedState {uid: 'hu:protocol-edition:blueprint-neg-missing-condition'}) SET n += {id: 'blueprint-neg-missing-condition', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', stateType: 'ProtocolEdition', editionLabel: 'NEG', changeProvenance: 'SOURCE_VERSIONED', payloadHash: 'sha256:8daf6a3f8f29429ccf0e2446d2a738fab0f6727555bc39a90120aa04dcdda7f0', payloadCanonicalizationVersion: 'W16-CANON-1', stepKeyAlignmentVersion: 'W16-STEPKEY-1'};
MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-neg-missing-condition'}), (b:ProtocolStep {uid: 'hu:protocol-step:blueprint-neg-mole-check-annual-v1'}) MERGE (a)-[r:HAS_PROTOCOL_STEP]->(b) SET r += {orderIndex: 1};

// Q-W16-04a (CQ-PR-02): conditional steps with their CNF condition structure (group, negation, kind, threshold).
MATCH (s:ProtocolStep {requirementLevel: 'CONDITIONAL'})-[r:HAS_CONSTRAINT]->(c:Constraint)
RETURN s.stepKey AS stepKey, r.constraintRole AS role, coalesce(r.conditionGroup, c.uid) AS orGroup, coalesce(r.negated, false) AS negated,
       c.constraintKind AS kind, c.comparator AS cmp, c.thresholdValue AS threshold, c.thresholdUnitCode AS unit
ORDER BY stepKey, orGroup, c.uid;

// Q-W16-04b: three-valued evaluation of the NICE branches against a HYPOTHETICAL non-personal fact set (in production the private store runs this
// with the person's facts; nothing is written back). Case 1: last level >= 0.8 true, the other five false.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:nice-cg185-lithium-2025-09-02'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep {requirementLevel: 'CONDITIONAL'})
MATCH (s)-[r:HAS_CONSTRAINT {constraintRole: 'APPLIES_WHEN'}]->(c:Constraint)
WITH s, coalesce(r.conditionGroup, c.uid) AS grp,
     CASE WHEN c.uid IN ['hu:constraint:nice-cg185-last-level-gte-0.8'] THEN (CASE WHEN coalesce(r.negated, false) THEN false ELSE true END)
          WHEN c.uid IN ['hu:constraint:nice-cg185-older-people', 'hu:constraint:nice-cg185-interacting-drugs', 'hu:constraint:nice-cg185-renal-thyroid-risk', 'hu:constraint:nice-cg185-poor-symptom-control', 'hu:constraint:nice-cg185-poor-adherence'] THEN (CASE WHEN coalesce(r.negated, false) THEN true ELSE false END)
          ELSE null END AS lit, c.uid AS cuid
WITH s, grp, collect({v: lit}) AS litMaps, collect(CASE WHEN lit IS NULL THEN cuid END) AS unknownFacts
WITH s, grp, [m IN litMaps | m.v] AS lits, unknownFacts
WITH s, unknownFacts, CASE WHEN any(x IN lits WHERE x = true) THEN 'T' WHEN all(x IN lits WHERE x = false) THEN 'F' ELSE 'U' END AS g
WITH s, collect(g) AS groups, [u IN collect(unknownFacts) | u] AS uf
RETURN s.stepKey AS stepKey,
       CASE WHEN 'F' IN groups THEN 'DOES_NOT_APPLY' WHEN all(x IN groups WHERE x = 'T') THEN 'APPLIES' ELSE 'UNKNOWN_MISSING_FACT' END AS applicability,
       reduce(acc = [], l IN uf | acc + l) AS missingFactConstraintUids
ORDER BY stepKey;

// Q-W16-04c: Case 2: four groups known false, 'older people' and 'poor adherence' not declared -> both branches UNKNOWN (missing fact), never DOES_NOT_APPLY.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:nice-cg185-lithium-2025-09-02'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep {requirementLevel: 'CONDITIONAL'})
MATCH (s)-[r:HAS_CONSTRAINT {constraintRole: 'APPLIES_WHEN'}]->(c:Constraint)
WITH s, coalesce(r.conditionGroup, c.uid) AS grp,
     CASE WHEN c.uid IN [] THEN (CASE WHEN coalesce(r.negated, false) THEN false ELSE true END)
          WHEN c.uid IN ['hu:constraint:nice-cg185-interacting-drugs', 'hu:constraint:nice-cg185-renal-thyroid-risk', 'hu:constraint:nice-cg185-poor-symptom-control', 'hu:constraint:nice-cg185-last-level-gte-0.8'] THEN (CASE WHEN coalesce(r.negated, false) THEN true ELSE false END)
          ELSE null END AS lit, c.uid AS cuid
WITH s, grp, collect({v: lit}) AS litMaps, collect(CASE WHEN lit IS NULL THEN cuid END) AS unknownFacts
WITH s, grp, [m IN litMaps | m.v] AS lits, unknownFacts
WITH s, unknownFacts, CASE WHEN any(x IN lits WHERE x = true) THEN 'T' WHEN all(x IN lits WHERE x = false) THEN 'F' ELSE 'U' END AS g
WITH s, collect(g) AS groups, [u IN collect(unknownFacts) | u] AS uf
RETURN s.stepKey AS stepKey,
       CASE WHEN 'F' IN groups THEN 'DOES_NOT_APPLY' WHEN all(x IN groups WHERE x = 'T') THEN 'APPLIES' ELSE 'UNKNOWN_MISSING_FACT' END AS applicability,
       reduce(acc = [], l IN uf | acc + l) AS missingFactConstraintUids
ORDER BY stepKey;

// Q-W16-04d: Blueprint MRI disjunction with only 'family history' known true -> APPLIES although age is unknown.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep {requirementLevel: 'CONDITIONAL'})
MATCH (s)-[r:HAS_CONSTRAINT {constraintRole: 'APPLIES_WHEN'}]->(c:Constraint)
WITH s, coalesce(r.conditionGroup, c.uid) AS grp,
     CASE WHEN c.uid IN ['hu:constraint:blueprint-family-history-high-risk'] THEN (CASE WHEN coalesce(r.negated, false) THEN false ELSE true END)
          WHEN c.uid IN [] THEN (CASE WHEN coalesce(r.negated, false) THEN true ELSE false END)
          ELSE null END AS lit, c.uid AS cuid
WITH s, grp, collect({v: lit}) AS litMaps, collect(CASE WHEN lit IS NULL THEN cuid END) AS unknownFacts
WITH s, grp, [m IN litMaps | m.v] AS lits, unknownFacts
WITH s, unknownFacts, CASE WHEN any(x IN lits WHERE x = true) THEN 'T' WHEN all(x IN lits WHERE x = false) THEN 'F' ELSE 'U' END AS g
WITH s, collect(g) AS groups, [u IN collect(unknownFacts) | u] AS uf
RETURN s.stepKey AS stepKey,
       CASE WHEN 'F' IN groups THEN 'DOES_NOT_APPLY' WHEN all(x IN groups WHERE x = 'T') THEN 'APPLIES' ELSE 'UNKNOWN_MISSING_FACT' END AS applicability,
       reduce(acc = [], l IN uf | acc + l) AS missingFactConstraintUids
ORDER BY stepKey;

// Q-W16-04e (CQ-PR-03, shared part): facts a person would have to declare before conditional steps of an edition can be evaluated.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:nice-cg185-lithium-2025-09-02'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep {requirementLevel: 'CONDITIONAL'})-[:HAS_CONSTRAINT]->(c:Constraint)
OPTIONAL MATCH (c)-[:BASED_ON]->(b)
RETURN c.uid AS constraintUid, c.constraintKind AS kind, collect(DISTINCT s.stepKey) AS gatesSteps, b.uid AS resolvableVia,
       CASE WHEN b IS NULL AND c.thresholdValue IS NULL THEN 'TEXT_ONLY_FACT' ELSE 'STRUCTURED_FACT' END AS factForm
ORDER BY constraintUid;
