// W16 fixture 10: 3-6 month cadence is a bounded range, never a midpoint (Blueprint 'Blood draw, every 3 to 6 months')
// Run: run-2026-10-04-fable51-01 · worker W16 · generated by a scratchpad script; every statement binds its own nodes by uid.
// Nodes carry primary + archetype labels (D-001). Snapshot hashes use contentHashBasis SYNTHETIC_FIXTURE ('synthetic:<uid>');
// payloadHash values are real sha256 over the W16-CANON-1 JSON canonicalization of the fixture payload.
// Sources: W16-S01 Blueprint live page and W16-S02 Wayback capture (identical text in both)
// Expected outcomes: see ../06-fixtures-and-queries.md section 10. Validators: 00-w16-validators.cypher.
MERGE (n:Protocol:Entity {uid: 'hu:protocol:blueprint-bryan-johnson'}) SET n += {id: 'blueprint-bryan-johnson', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'Protocol', name: 'Bryan Johnson Protocol (Blueprint page)', protocolType: 'SUPPLEMENT_PROTOCOL', publicUrl: 'https://blueprint.bryanjohnson.com/blogs/news/bryan-johnsons-protocol'};
MERGE (n:Person:Entity {uid: 'hu:person:bryan-johnson'}) SET n += {id: 'bryan-johnson', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'Person', name: 'Bryan Johnson'};
MERGE (n:Metric:Entity {uid: 'hu:metric:hscrp'}) SET n += {id: 'hscrp', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'Metric', name: 'hsCRP'};
MERGE (n:ProtocolStep:Entity {uid: 'hu:protocol-step:blueprint-routine-blood-draw-v1'}) SET n += {id: 'blueprint-routine-blood-draw-v1', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'ProtocolStep', stepKey: 'routine-blood-draw', payloadHash: 'sha256:63fd69b6d6f1175db8dac81657f0d8ed231938dfa37f3a11f710bc6860915cc1', name: 'Blood draw', stepKind: 'SAMPLE', requirementLevel: 'NOT_STATED', requirementBasis: 'NOT_STATED', speechAct: 'STATES', schedulePattern: 'RECURRING', cadenceUnit: 'MONTH', cadenceIntervalMin: 3, cadenceIntervalMax: 6, scheduleText: 'Blood draw, every 3 to 6 months'};
MERGE (n:MeasurementPlan:Entity {uid: 'hu:measurement-plan:blueprint-routine-blood-draw'}) SET n += {id: 'blueprint-routine-blood-draw', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'MeasurementPlan', name: 'Routine blood draw', planTiming: 'PERIODIC', requiredForEvaluation: null, cadenceMinDays: 90, cadenceMaxDays: 183, scheduleText: 'Blood draw, every 3 to 6 months'};
MATCH (a:MeasurementPlan {uid: 'hu:measurement-plan:blueprint-routine-blood-draw'}), (b:Metric {uid: 'hu:metric:hscrp'}) MERGE (a)-[r:TRACKS_METRIC]->(b);
MERGE (n:ProtocolEdition:VersionedState {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}) SET n += {id: 'blueprint-observed-2026-10-04', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', stateType: 'ProtocolEdition', editionLabel: null, changeProvenance: 'SNAPSHOT_DIFF', payloadHash: 'sha256:73d6dec52b3a818fa204ccbf88e3df97fdf633bc29ed9316d264ffed7d0d2ac1', payloadCanonicalizationVersion: 'W16-CANON-1', stepKeyAlignmentVersion: 'W16-STEPKEY-1'};
MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}), (b:ProtocolStep {uid: 'hu:protocol-step:blueprint-routine-blood-draw-v1'}) MERGE (a)-[r:HAS_PROTOCOL_STEP]->(b) SET r += {orderIndex: 1, sectionLabel: 'Routine Measurement', sourceStepLabel: '1'};
MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}), (b:MeasurementPlan {uid: 'hu:measurement-plan:blueprint-routine-blood-draw'}) MERGE (a)-[r:HAS_MEASUREMENT_PLAN]->(b) SET r += {orderIndex: 1};

// NEGATIVE (expected V-529b POSSIBLE_RANGE_COLLAPSE x2 and V-529p RANGE_INVERTED): midpoint/endpoint collapse and an inverted plan range.
MERGE (n:ProtocolStep:Entity {uid: 'hu:protocol-step:blueprint-neg-routine-blood-draw-v1'}) SET n += {id: 'blueprint-neg-routine-blood-draw-v1', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'ProtocolStep', stepKey: 'routine-blood-draw', payloadHash: 'sha256:930ca97e6e8a96063797a8fd3b47c10bf1f9af01a918ae3874eb8ba414f364e9', name: 'NEG collapsed range', stepKind: 'SAMPLE', requirementLevel: 'NOT_STATED', cadenceUnit: 'MONTH', cadenceIntervalMin: 4, cadenceIntervalMax: 4, scheduleText: 'Blood draw, every 3 to 6 months', requirementBasis: 'STATED_BY_SOURCE'};
MERGE (n:ProtocolEdition:VersionedState {uid: 'hu:protocol-edition:blueprint-neg-range'}) SET n += {id: 'blueprint-neg-range', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', stateType: 'ProtocolEdition', editionLabel: 'NEG', changeProvenance: 'SOURCE_VERSIONED', payloadHash: 'sha256:501cdc201d6ec3f097867791b8f30f753bb7e7b4eda620e1b0b708f6278eb764', payloadCanonicalizationVersion: 'W16-CANON-1', stepKeyAlignmentVersion: 'W16-STEPKEY-1'};
MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-neg-range'}), (b:ProtocolStep {uid: 'hu:protocol-step:blueprint-neg-routine-blood-draw-v1'}) MERGE (a)-[r:HAS_PROTOCOL_STEP]->(b) SET r += {orderIndex: 1};
MERGE (n:MeasurementPlan:Entity {uid: 'hu:measurement-plan:neg-collapsed'}) SET n += {id: 'neg-collapsed', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'MeasurementPlan', name: 'NEG collapsed plan', planTiming: 'PERIODIC', cadenceMinDays: 135, cadenceMaxDays: 135, scheduleText: 'every 3 to 6 months'};
MERGE (n:MeasurementPlan:Entity {uid: 'hu:measurement-plan:neg-inverted'}) SET n += {id: 'neg-inverted', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'MeasurementPlan', name: 'NEG inverted plan', planTiming: 'PERIODIC', cadenceMinDays: 183, cadenceMaxDays: 90};

// Q-W16-10a: the cadence as stored: both bounds, unit and verbatim text.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)
OPTIONAL MATCH (e)-[:HAS_MEASUREMENT_PLAN]->(m:MeasurementPlan)
RETURN s.stepKey AS stepKey, s.cadenceIntervalMin AS minMonths, s.cadenceIntervalMax AS maxMonths, s.cadenceUnit AS unit, m.cadenceMinDays AS minDays, m.cadenceMaxDays AS maxDays, s.scheduleText AS text;

// Q-W16-10b: due window after a given public draw date (literal 2026-01-15): earliest/latest, never a single due date.
MATCH (m:MeasurementPlan {uid: 'hu:measurement-plan:blueprint-routine-blood-draw'})
WITH m, date('2026-01-15') AS last
RETURN last AS lastDraw, last + duration({days: m.cadenceMinDays}) AS windowOpens, last + duration({days: m.cadenceMaxDays}) AS windowCloses,
       CASE WHEN date('2026-06-01') < last + duration({days: m.cadenceMinDays}) THEN 'NOT_YET_DUE'
            WHEN date('2026-06-01') <= last + duration({days: m.cadenceMaxDays}) THEN 'WITHIN_WINDOW' ELSE 'OVERDUE' END AS statusOn20260601;
