MATCH (a:Assertion {uid: 'hu:assertion:neg-combined-stack-effective'}), (b:Outcome {uid: 'hu:outcome:igf-1-reduction'}) MERGE (a)-[r:HAS_OBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:neg-combined-stack-effective'}), (b:Assertion {uid: 'hu:assertion:synthetic-fmd-step-cites-wei-2017'}) MERGE (a)-[r:DERIVED_FROM_ASSERTION]->(b);

// Q-W16-09a (CQ-PR-06): evidence per step versus the protocol as a whole.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:synthetic-combined-longevity-stack-e1'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)
OPTIONAL MATCH (a:Assertion {predicate: 'CITES_EVIDENCE_FOR_STEP'})-[:HAS_SUBJECT]->(s)
OPTIONAL MATCH (a)-[:HAS_OBJECT]->(pub)
RETURN 'STEP' AS level, s.stepKey AS item, collect(pub.uid) AS citedEvidence,
       CASE WHEN count(pub) = 0 THEN 'NO_STEP_EVIDENCE_CITED' ELSE 'STEP_EVIDENCE_CITED_NOT_ASSESSED_FOR_APPLICABILITY' END AS reading
UNION
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:synthetic-combined-longevity-stack-e1'})
OPTIONAL MATCH (a:Assertion)-[:HAS_SUBJECT]->(e) WHERE a.predicate IN ['PROTOCOL_EFFECTIVE_FOR', 'SUPPORTED_BY_EVIDENCE'] AND coalesce(a.basisKind, '') <> 'CALCULATED'
RETURN 'PROTOCOL' AS level, e.uid AS item, collect(a.uid) AS citedEvidence,
       CASE WHEN count(a) = 0 THEN 'NO_PROTOCOL_LEVEL_EVIDENCE' ELSE 'PROTOCOL_LEVEL_EVIDENCE_PRESENT' END AS reading;

// Q-W16-09b: role attribution for steps and edition with asserter and locator.
MATCH (a:Assertion)-[:HAS_SUBJECT]->(x) WHERE a.predicate IN ['AUTHORED_PROTOCOL_EDITION', 'REQUIRES_PERFORMER_ROLE']
OPTIONAL MATCH (a)-[:HAS_OBJECT]->(o) OPTIONAL MATCH (a)-[:ASSERTED_BY]->(who) OPTIONAL MATCH (a)-[:SUPPORTED_BY]->(l:SourceLocator)
RETURN a.predicate AS predicate, coalesce(x.stepKey, x.uid) AS subject, coalesce(o.uid, a.valueString) AS roleOrAgent, who.uid AS asserter, l.uid AS locator ORDER BY predicate;
