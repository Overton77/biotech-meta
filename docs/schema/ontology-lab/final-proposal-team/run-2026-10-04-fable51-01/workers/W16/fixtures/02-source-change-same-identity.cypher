// Authorship of the page (assertion-backed): the protocol's own asserter, used to classify reports as THIRD_PARTY_REPORTED.
MERGE (n:Assertion {uid: 'hu:assertion:blueprint-authored-by-bryan-johnson'}) SET n += {predicate: 'AUTHORED_PROTOCOL', status: 'ACCEPTED', polarity: 'POSITIVE', recordedAt: datetime('2026-10-04T01:00:00Z'), recordedTo: null, contentHash: 'sha256:ec152dd61002f1c0afb94c6652758eec434dd16e02ede2a772b7fb88e316a49e', privacyClass: 'PUBLIC', speechAct: 'STATES', assertionBasis: 'UNSTATED'};
MATCH (a:Assertion {uid: 'hu:assertion:blueprint-authored-by-bryan-johnson'}), (b:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'}) MERGE (a)-[r:HAS_SUBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:blueprint-authored-by-bryan-johnson'}), (b:Person {uid: 'hu:person:bryan-johnson'}) MERGE (a)-[r:HAS_OBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:blueprint-authored-by-bryan-johnson'}), (b:SourceLocator {uid: 'hu:locator:blueprint-protocol-2026-10-04-rx'}) MERGE (a)-[r:SUPPORTED_BY]->(b);

// Third-party reports (NAD.com, 2026-03-24): Assertions, never editions. Rapamycin step ended in 2024 (YEAR precision); NMN/NR six days a week.
MERGE (n:Assertion {uid: 'hu:assertion:nadcom-rapamycin-stopped-2024'}) SET n += {predicate: 'PROTOCOL_INCLUDES_SUBSTANCE', status: 'ACCEPTED', polarity: 'POSITIVE', recordedAt: datetime('2026-10-04T01:00:00Z'), recordedTo: null, contentHash: 'sha256:ce27691d92fd7bc07c1a91ab7605c9a79f0f1124869678c3b6eba9925ab44119', privacyClass: 'PUBLIC', validTo: datetime('2024-01-01T00:00:00Z'), validToPrecision: 'YEAR', validToBasis: 'STATED_BY_SOURCE', validFromBasis: 'UNKNOWN', speechAct: 'STATES', assertionBasis: 'THIRD_PARTY_ANECDOTE'};
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-rapamycin-stopped-2024'}), (b:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'}) MERGE (a)-[r:HAS_SUBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-rapamycin-stopped-2024'}), (b:ChemicalSubstance {uid: 'hu:substance:rapamycin'}) MERGE (a)-[r:HAS_OBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-rapamycin-stopped-2024'}), (b:SourceLocator {uid: 'hu:locator:nadcom-johnson-2026-key-points'}) MERGE (a)-[r:SUPPORTED_BY]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-rapamycin-stopped-2024'}), (b:Organization {uid: 'hu:org:nad-com'}) MERGE (a)-[r:ASSERTED_BY]->(b);
MERGE (n:Assertion {uid: 'hu:assertion:nadcom-nmn-six-days-a-week'}) SET n += {predicate: 'STEP_OCCURRENCES_PER_WEEK', status: 'ACCEPTED', polarity: 'POSITIVE', recordedAt: datetime('2026-10-04T01:00:00Z'), recordedTo: null, contentHash: 'sha256:bc92a2d35a6a562d96708bdf74d1235eca5fb6303efe247b1f94d4575ab81af0', privacyClass: 'PUBLIC', valueNumber: 6.0, unitCode: '/wk', valueString: 'NMN or NR 500 mg (6x/week)', validFromBasis: 'UNKNOWN', validToBasis: 'UNKNOWN', speechAct: 'STATES', assertionBasis: 'THIRD_PARTY_ANECDOTE'};
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-nmn-six-days-a-week'}), (b:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'}) MERGE (a)-[r:HAS_SUBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-nmn-six-days-a-week'}), (b:SourceLocator {uid: 'hu:locator:nadcom-johnson-2026-key-points'}) MERGE (a)-[r:SUPPORTED_BY]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:nadcom-nmn-six-days-a-week'}), (b:Organization {uid: 'hu:org:nad-com'}) MERGE (a)-[r:ASSERTED_BY]->(b);

// NEGATIVE (expected V-530p row): an edition minted from the third-party report.
MERGE (n:ProtocolEdition:VersionedState {uid: 'hu:protocol-edition:blueprint-neg-from-nadcom-report'}) SET n += {id: 'blueprint-neg-from-nadcom-report', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', stateType: 'ProtocolEdition', changeProvenance: 'THIRD_PARTY_REPORTED', payloadHash: 'sha256:0c6d21a1e5b83e4fc9d5792033c3b7c72591dc1d9a2fe2657bf5158ebe7ada19', editionLabel: null};

// Q-W16-02a: the enduring identity is one Protocol node with two editions; the protocol uid and its properties did not change.
MATCH (p:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'})-[h:HAS_PROTOCOL_EDITION]->(e:ProtocolEdition)
RETURN p.uid AS protocolUid, count(e) AS editions, collect(e.changeProvenance) AS provenances;

// Q-W16-02b (CQ-PR-01): dose changes for the same stepKey across the two observed editions (declared dose, basis preserved).
MATCH (e1:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-01-24'})-[:HAS_PROTOCOL_STEP]->(s1:ProtocolStep)-[u1:USES]->(x),
      (e2:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})-[:HAS_PROTOCOL_STEP]->(s2:ProtocolStep)-[u2:USES]->(x)
WHERE s1.stepKey = s2.stepKey
RETURN s1.stepKey AS stepKey, s1 = s2 AS sameStepNode, u1.quantity AS oldQty, u1.quantityBasis AS oldBasis, u2.quantity AS newQty, u2.quantityBasis AS newBasis,
       s2.occurrencesPerPeriodMax AS newPerDay, u1.verbatimDoseText AS oldText, u2.verbatimDoseText AS newText
ORDER BY stepKey;

// Q-W16-02c (CQ-PR-01): change-provenance labelled history: editions plus third-party assertions; unobserved intervals stay unknown.
MATCH (p:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'})
CALL { WITH p MATCH (p)-[h:HAS_PROTOCOL_EDITION]->(e:ProtocolEdition)
       MATCH (a:Assertion {uid: h.assertionUid})-[:SUPPORTED_BY]->(:SourceLocator)<-[:HAS_LOCATOR]-(sn:SourceSnapshot)
       RETURN e.uid AS item, e.changeProvenance AS provenance, sn.observedAt AS observedAt, h.validFrom AS validFrom, h.validFromBasis AS validFromBasis,
              h.validTo AS validTo, h.validToBasis AS validToBasis
       UNION
       WITH p MATCH (a:Assertion)-[:HAS_SUBJECT]->(p) WHERE a.predicate <> 'HAS_PROTOCOL_EDITION' AND a.predicate <> 'AUTHORED_PROTOCOL'
       OPTIONAL MATCH (a)-[:ASSERTED_BY]->(who)
       OPTIONAL MATCH (au:Assertion {predicate: 'AUTHORED_PROTOCOL'})-[:HAS_SUBJECT]->(p)
       OPTIONAL MATCH (au)-[:HAS_OBJECT]->(author)
       WITH a, who, collect(author.uid) AS authors
       RETURN a.uid AS item, CASE WHEN who IS NULL OR who.uid IN authors THEN 'OWNER_STATED' ELSE 'THIRD_PARTY_REPORTED' END AS provenance,
              null AS observedAt, a.validFrom AS validFrom, a.validFromBasis AS validFromBasis, a.validTo AS validTo, a.validToBasis AS validToBasis }
RETURN item, provenance, observedAt, validFrom, validFromBasis, validTo, validToBasis ORDER BY provenance, item;
