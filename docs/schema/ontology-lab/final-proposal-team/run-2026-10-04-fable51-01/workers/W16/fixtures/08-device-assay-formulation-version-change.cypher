MATCH (a:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2024'}), (b:SourceLocator {uid: 'hu:locator:blueprint-protocol-2026-10-04-morning'}) MERGE (a)-[r:SUPPORTED_BY]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2024'}), (b:Person {uid: 'hu:person:bryan-johnson'}) MERGE (a)-[r:ASSERTED_BY]->(b);
MATCH (a:Person {uid: 'hu:person:bryan-johnson'}), (b:Observation {uid: 'hu:observation:synthetic-hscrp-2024'}), (x:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2024'}) MERGE (a)-[r:RECORDS {relationshipUid: 'hu:rel:synthetic-bj-records-hscrp-2024'}]->(b) SET r.assertionUid = x.uid, r.validFrom = x.validFrom, r.validFromPrecision = x.validFromPrecision, r.validFromBasis = coalesce(x.validFromBasis, 'UNKNOWN'), r.validTo = x.validTo, r.validToPrecision = x.validToPrecision, r.validToBasis = coalesce(x.validToBasis, 'UNKNOWN'), r.recordedFrom = x.recordedAt, r.recordedTo = x.recordedTo;
MERGE (n:Observation:InformationArtifact {uid: 'hu:observation:synthetic-hscrp-2025'}) SET n += {id: 'synthetic-hscrp-2025', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', artifactType: 'Observation', resultKind: 'MEASURED', valueNumber: 0.2, unitCode: 'mg/L', valueStatus: 'REPORTED', observedAt: datetime('2025-03-01T00:00:00Z'), observedPopulation: 'protocol author, self-reported (SYNTHETIC values)'};
MATCH (a:Observation {uid: 'hu:observation:synthetic-hscrp-2025'}), (b:AssayVersion {uid: 'hu:assay-version:synthetic-hscrp-lab-a-2025'}) MERGE (a)-[r:PRODUCED_BY_ASSAY_VERSION]->(b);
MATCH (a:Observation {uid: 'hu:observation:synthetic-hscrp-2025'}), (b:LabTest {uid: 'hu:lab-test:synthetic-hscrp-lab-a'}) MERGE (a)-[r:FROM_LAB_TEST]->(b);
MERGE (n:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2025'}) SET n += {predicate: 'RECORDS', status: 'ACCEPTED', polarity: 'POSITIVE', recordedAt: datetime('2026-10-04T01:00:00Z'), recordedTo: null, contentHash: 'sha256:d163d9e1d0b69c415b110ff360d099c14d81a77250f4b911c55b45ff79e97b7e', privacyClass: 'PUBLIC', speechAct: 'REPORTS_PRACTICE', assertionBasis: 'PERSONAL_EXPERIENCE', validFromBasis: 'UNKNOWN', validToBasis: 'UNKNOWN'};
MATCH (a:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2025'}), (b:Person {uid: 'hu:person:bryan-johnson'}) MERGE (a)-[r:HAS_SUBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2025'}), (b:Observation {uid: 'hu:observation:synthetic-hscrp-2025'}) MERGE (a)-[r:HAS_OBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2025'}), (b:SourceLocator {uid: 'hu:locator:blueprint-protocol-2026-10-04-morning'}) MERGE (a)-[r:SUPPORTED_BY]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2025'}), (b:Person {uid: 'hu:person:bryan-johnson'}) MERGE (a)-[r:ASSERTED_BY]->(b);
MATCH (a:Person {uid: 'hu:person:bryan-johnson'}), (b:Observation {uid: 'hu:observation:synthetic-hscrp-2025'}), (x:Assertion {uid: 'hu:assertion:synthetic-bj-records-hscrp-2025'}) MERGE (a)-[r:RECORDS {relationshipUid: 'hu:rel:synthetic-bj-records-hscrp-2025'}]->(b) SET r.assertionUid = x.uid, r.validFrom = x.validFrom, r.validFromPrecision = x.validFromPrecision, r.validFromBasis = coalesce(x.validFromBasis, 'UNKNOWN'), r.validTo = x.validTo, r.validToPrecision = x.validToPrecision, r.validToBasis = coalesce(x.validToBasis, 'UNKNOWN'), r.recordedFrom = x.recordedAt, r.recordedTo = x.recordedTo;

// Q-W16-08a: material binding of a step: PINNED when USES targets a FormulationVersion; otherwise the formulation in force at the edition's
// observation instant is RESOLVED_AS_OF via HAS_FORMULATION_VERSION (W04), never stored as if the source stated it.
MATCH (e:ProtocolEdition)-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep {stepKey: 'longevity-mix-pre-workout'})-[u:USES]->(x)
OPTIONAL MATCH (:Protocol)-[h:HAS_PROTOCOL_EDITION]->(e)
OPTIONAL MATCH (a:Assertion {uid: h.assertionUid})-[:SUPPORTED_BY]->(:SourceLocator)<-[:HAS_LOCATOR]-(sn:SourceSnapshot)
WITH e, s, x, sn.observedAt AS at
OPTIONAL MATCH (x)-[f:HAS_FORMULATION_VERSION]->(fv:FormulationVersion)
WHERE f.recordedTo IS NULL AND at IS NOT NULL AND f.validFrom <= at AND (f.validTo IS NULL OR at < f.validTo)
RETURN e.uid AS edition, [l IN labels(x) WHERE NOT l IN ['Entity', 'VersionedState']][0] AS usesLabel, at AS observedAt,
       CASE WHEN x:FormulationVersion THEN 'PINNED' WHEN fv IS NOT NULL THEN 'RESOLVED_AS_OF' ELSE 'UNRESOLVED' END AS binding,
       coalesce(CASE WHEN x:FormulationVersion THEN x.uid END, fv.uid) AS formulationUid
ORDER BY edition;

// Q-W16-08b: instrument change shows up as a MODIFIED step (new payloadHash, same stepKey) in the edition diff.
MATCH (old:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-01-24'}), (new:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})
CALL { WITH old OPTIONAL MATCH (:Protocol)-[h:HAS_PROTOCOL_EDITION]->(old) OPTIONAL MATCH (a:Assertion {uid: h.assertionUid})-[:SUPPORTED_BY]->(:SourceLocator)<-[:HAS_LOCATOR]-(sn:SourceSnapshot)
       RETURN collect(DISTINCT sn.captureCompleteness) AS oldCapture }
CALL { WITH new OPTIONAL MATCH (:Protocol)-[h:HAS_PROTOCOL_EDITION]->(new) OPTIONAL MATCH (a:Assertion {uid: h.assertionUid})-[:SUPPORTED_BY]->(:SourceLocator)<-[:HAS_LOCATOR]-(sn:SourceSnapshot)
       RETURN collect(DISTINCT sn.captureCompleteness) AS newCapture }
CALL { WITH old OPTIONAL MATCH (old)-[r:HAS_PROTOCOL_STEP]->(s:ProtocolStep) RETURN collect({k: s.stepKey, h: s.payloadHash, o: r.orderIndex}) AS O }
CALL { WITH new OPTIONAL MATCH (new)-[r:HAS_PROTOCOL_STEP]->(s:ProtocolStep) RETURN collect({k: s.stepKey, h: s.payloadHash, o: r.orderIndex}) AS N }
WITH old, new, oldCapture, newCapture, O, N, any(c IN oldCapture WHERE c <> 'COMPLETE') AS oldPartial, any(c IN newCapture WHERE c <> 'COMPLETE') AS newPartial
UNWIND [x IN O | x.k] + [x IN N | x.k] AS stepKey
WITH DISTINCT old, new, oldPartial, newPartial, stepKey, head([x IN O WHERE x.k = stepKey]) AS o, head([x IN N WHERE x.k = stepKey]) AS n
RETURN stepKey,
       CASE WHEN o IS NULL AND oldPartial THEN 'ADDED_OR_NOT_CAPTURED' WHEN o IS NULL THEN 'ADDED'
            WHEN n IS NULL AND newPartial THEN 'REMOVED_OR_NOT_CAPTURED' WHEN n IS NULL THEN 'REMOVED'
            WHEN o.h = n.h THEN 'UNCHANGED' ELSE 'MODIFIED' END AS changeKind,
       o.o AS oldOrder, n.o AS newOrder, (o IS NOT NULL AND n IS NOT NULL AND o.o <> n.o) AS reordered,
       new.changeProvenance AS changeProvenance, old.editionLabel AS oldLabel, new.editionLabel AS newLabel
ORDER BY stepKey;

// Q-W16-08c (INV-301 via W07 contract): can the two public hsCRP observations be compared on one axis?
MATCH (o1:Observation {uid: 'hu:observation:synthetic-hscrp-2024'})-[:PRODUCED_BY_ASSAY_VERSION]->(a1),
      (o2:Observation {uid: 'hu:observation:synthetic-hscrp-2025'})-[:PRODUCED_BY_ASSAY_VERSION]->(a2)
OPTIONAL MATCH (c)-[:COMPARES]->(a1) WHERE (c)-[:COMPARES]->(a2) AND c.verdict IN ['COMPARABLE', 'COMPARABLE_WITH_CONVERSION']
RETURN a1 = a2 AS sameAssayVersion, c IS NOT NULL AS comparabilityAssessed,
       CASE WHEN a1 = a2 OR c IS NOT NULL THEN 'SAME_AXIS' ELSE 'NOT_ESTABLISHED' END AS comparability;
