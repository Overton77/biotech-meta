// Expected outcomes: see ../06-fixtures-and-queries.md section 07. Validators: 00-w16-validators.cypher.
MERGE (n:Protocol:Entity {uid: 'hu:protocol:blueprint-bryan-johnson'}) SET n += {id: 'blueprint-bryan-johnson', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'Protocol', name: 'Bryan Johnson Protocol (Blueprint page)', protocolType: 'SUPPLEMENT_PROTOCOL', publicUrl: 'https://blueprint.bryanjohnson.com/blogs/news/bryan-johnsons-protocol'};
