MATCH (a:Source {uid: 'hu:source:blueprint-protocol-page'}), (b:SourceSnapshot {uid: 'hu:snapshot:blueprint-protocol-2026-10-04'}) MERGE (a)-[r:HAS_SNAPSHOT]->(b);
MATCH (a:SourceSnapshot {uid: 'hu:snapshot:blueprint-protocol-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:blueprint-protocol-2026-10-04-hbot-results'}) MERGE (a)-[r:HAS_LOCATOR]->(b);
MERGE (n:ProtocolStep:Entity {uid: 'hu:protocol-step:blueprint-hbot-course-v1'}) SET n += {id: 'blueprint-hbot-course-v1', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'ProtocolStep', stepKey: 'hbot-course', payloadHash: 'sha256:f28104af00773491bd51946e4a7c2b755cbd2dba2207b4737a7f72e79e80d852', name: 'HBOT course', stepKind: 'OTHER', requirementLevel: 'NOT_STATED', requirementBasis: 'NOT_STATED', speechAct: 'REPORTS_PRACTICE'};
MERGE (n:ProtocolEdition:VersionedState {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}) SET n += {id: 'blueprint-observed-2026-10-04', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', stateType: 'ProtocolEdition', editionLabel: null, changeProvenance: 'SNAPSHOT_DIFF', payloadHash: 'sha256:9abf09a70d5b65b5f0efae85907214e07d1474f77b718fa20775cb8ad91ab788', payloadCanonicalizationVersion: 'W16-CANON-1', stepKeyAlignmentVersion: 'W16-STEPKEY-1'};
MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}), (b:ProtocolStep {uid: 'hu:protocol-step:blueprint-hbot-course-v1'}) MERGE (a)-[r:HAS_PROTOCOL_STEP]->(b) SET r += {orderIndex: 1};
MERGE (n:Assertion {uid: 'hu:assertion:blueprint-has-edition-2026-10-04'}) SET n += {predicate: 'HAS_PROTOCOL_EDITION', status: 'ACCEPTED', polarity: 'POSITIVE', recordedAt: datetime('2026-10-04T01:00:00Z'), recordedTo: null, contentHash: 'sha256:d0af9c3676af5c77a318c785e164419d7d7fc70147c5c0b1524b243630baa1f4', privacyClass: 'PUBLIC', validFrom: null, validFromPrecision: null, validFromBasis: 'OBSERVATION_ONLY', validTo: null, validToPrecision: null, validToBasis: 'UNKNOWN', speechAct: 'STATES', assertionBasis: 'UNSTATED'};
MATCH (a:Assertion {uid: 'hu:assertion:blueprint-has-edition-2026-10-04'}), (b:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'}) MERGE (a)-[r:HAS_SUBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:blueprint-has-edition-2026-10-04'}), (b:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}) MERGE (a)-[r:HAS_OBJECT]->(b);
MATCH (a:Assertion {uid: 'hu:assertion:blueprint-has-edition-2026-10-04'}), (b:SourceLocator {uid: 'hu:locator:blueprint-protocol-2026-10-04-hbot-results'}) MERGE (a)-[r:SUPPORTED_BY]->(b);
MATCH (a:Protocol {uid: 'hu:protocol:blueprint-bryan-johnson'}), (b:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'}), (x:Assertion {uid: 'hu:assertion:blueprint-has-edition-2026-10-04'}) MERGE (a)-[r:HAS_PROTOCOL_EDITION {relationshipUid: 'hu:rel:blueprint-edition-2026-10-04'}]->(b) SET r.assertionUid = x.uid, r.validFrom = x.validFrom, r.validFromPrecision = x.validFromPrecision, r.validFromBasis = coalesce(x.validFromBasis, 'UNKNOWN'), r.validTo = x.validTo, r.validToPrecision = x.validToPrecision, r.validToBasis = coalesce(x.validToBasis, 'UNKNOWN'), r.recordedFrom = x.recordedAt, r.recordedTo = x.recordedTo;

