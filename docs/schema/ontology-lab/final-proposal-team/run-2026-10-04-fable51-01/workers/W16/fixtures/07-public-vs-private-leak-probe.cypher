MERGE (n:Source:Entity {uid: 'hu:source:blueprint-protocol-page'}) SET n += {id: 'blueprint-protocol-page', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', entityType: 'Source', canonicalUri: 'https://blueprint.bryanjohnson.com/blogs/news/bryan-johnsons-protocol', title: 'Bryan Johnson\'s Protocol', sourceKind: 'SELF_DISCLOSURE_PAGE'};
MERGE (n:SourceSnapshot:InformationArtifact {uid: 'hu:snapshot:blueprint-protocol-2026-10-04'}) SET n += {id: 'blueprint-protocol-2026-10-04', createdAt: datetime('2026-10-04T01:00:00Z'), privacyClass: 'PUBLIC', artifactType: 'SourceSnapshot', canonicalUri: 'https://blueprint.bryanjohnson.com/blogs/news/bryan-johnsons-protocol', observedAt: datetime('2026-10-04T00:56:00Z'), retrievedAt: datetime('2026-10-04T00:56:00Z'), publishedAt: null, contentHash: 'synthetic:hu:snapshot:blueprint-protocol-2026-10-04', contentHashBasis: 'SYNTHETIC_FIXTURE', captureCompleteness: 'PARTIAL_EXCERPT'};
