// Q-W16-11a (CQ-PR-02/CQ-PR-03): for each step, the results it must wait for and the metrics those results measure.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:nice-cg185-lithium-2025-09-02'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)-[d:DEPENDS_ON {dependencyKind: 'REQUIRES_RESULT_OF'}]->(t:ProtocolStep)
OPTIONAL MATCH (s)-[:HAS_CONSTRAINT]->(:Constraint)-[:BASED_ON]->(m:Metric)
RETURN s.stepKey AS waitingStep, t.stepKey AS waitsForResultOf, d.dependencyBasis AS basis, collect(DISTINCT m.uid) AS gatingMetrics ORDER BY waitingStep;

// Q-W16-11b (CQ-PR-04): review rules of the edition, what triggers them, which steps they modify; public triggers never write private decisions.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:nice-cg185-lithium-2025-09-02'})-[:HAS_ADJUSTMENT_RULE]->(r:ProtocolAdjustmentRule)
OPTIONAL MATCH (r)-[:RULE_TRIGGERED_BY]->(m:Metric) OPTIONAL MATCH (r)-[:MODIFIES_STEP]->(s:ProtocolStep)
RETURN r.uid AS rule, r.triggerKind AS triggerKind, r.triggerAction AS action, r.ruleBasis AS basis, collect(DISTINCT m.uid) AS metrics, collect(DISTINCT s.stepKey) AS modifies;
