// Q-W16-06a: what the public template requires; an omitted OPTIONAL step is consistent with the template (no adherence verdict is computed).
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:synthetic-evening-wind-down-e1'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)
RETURN s.stepKey AS stepKey, s.requirementLevel AS level, s.requirementBasis AS basis,
       CASE s.requirementLevel WHEN 'OPTIONAL' THEN 'OMISSION_CONSISTENT_WITH_TEMPLATE' WHEN 'ESSENTIAL' THEN 'TEMPLATE_REQUIRES' ELSE 'SEE_CONDITIONS' END AS templateReading
ORDER BY stepKey;

// Q-W16-06b: does the shared graph hold anyone's adherence for this edition? Expected: no adherence records; only a public practice report Assertion.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:synthetic-evening-wind-down-e1'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)
OPTIONAL MATCH (a:Assertion)-[:HAS_OBJECT]->(s)
RETURN s.stepKey AS stepKey, count(a) AS publicPracticeReports, 'ADHERENCE_NOT_IN_SHARED_GRAPH' AS adherence ORDER BY stepKey;
