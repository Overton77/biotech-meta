// Q-W16-05a: parallel groups (CONCURRENT_WITH, symmetric) and sequence (ordering kinds) for one edition.
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)-[d:DEPENDS_ON]->(t:ProtocolStep)
RETURN s.stepKey AS step, d.dependencyKind AS kind, t.stepKey AS other,
       CASE d.dependencyKind WHEN 'CONCURRENT_WITH' THEN 'PARALLEL' WHEN 'MUTUALLY_EXCLUSIVE_WITH' THEN 'ALTERNATIVE' ELSE 'SEQUENTIAL' END AS structure
ORDER BY structure, step;

// Q-W16-05b: what the source RECOMMENDS to readers vs what the author REPORTS doing (a practice report is not a recommendation).
MATCH (e:ProtocolEdition {uid: 'hu:protocol-edition:blueprint-observed-2026-10-04'})-[:HAS_PROTOCOL_STEP]->(s:ProtocolStep)
WHERE s.stepKindRaw = 'SAUNA'
RETURN s.stepKey AS stepKey, s.speechAct AS speechAct, s.occurrencesPerPeriodMin AS perWeekMin, s.occurrencesPerPeriodMax AS perWeekMax,
       s.durationMinutesMin AS minMin, s.durationMinutesMax AS minMax ORDER BY speechAct;

// Q-W16-05c (CQ-RC-06 shared part): contraindication constraint uids that would BLOCK the sauna steps (any one suffices: one OR group).
MATCH (s:ProtocolStep)-[r:HAS_CONSTRAINT {constraintRole: 'CONTRAINDICATED_WHEN'}]->(c:Constraint)
RETURN s.stepKey AS stepKey, r.conditionGroup AS orGroup, collect(c.uid) AS blockingConstraintUids ORDER BY stepKey;
