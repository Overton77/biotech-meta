// Q-W16-01 (CQ-PR-01): step-level diff of two editions by stepKey and payloadHash, with change provenance and capture completeness.
// A step missing from a PARTIAL capture is ADDED_OR_NOT_CAPTURED, never ADDED; order changes are reported separately.
MATCH (old:ProtocolEdition {uid: 'hu:protocol-edition:protocolsio-pbmc-cpt-v1'}), (new:ProtocolEdition {uid: 'hu:protocol-edition:protocolsio-pbmc-cpt-v2'})
CALL { WITH old OPTIONAL MATCH (:Protocol)-[h:HAS_PROTOCOL_EDITION]->(old) OPTIONAL MATCH (a:Assertion {uid: h.assertionUid})-[:SUPPORTED_BY]->(:SourceLocator)<-[:HAS_LOCATOR]-(sn:SourceSnapshot)
       RETURN collect(DISTINCT sn.captureCompleteness) AS oldCapture }
CALL { WITH new OPTIONAL MATCH (:Protocol)-[h:HAS_PROTOCOL_EDITION]->(new) OPTIONAL MATCH (a:Assertion {uid: h.assertionUid})-[:SUPPORTED_BY]->(:SourceLocator)<-[:HAS_LOCATOR]-(sn:SourceSnapshot)
       RETURN collect(DISTINCT sn.captureCompleteness) AS newCapture }
CALL { WITH old OPTIONAL MATCH (old)-[r:HAS_PROTOCOL_STEP]->(s:ProtocolStep) RETURN collect({k: s.stepKey, h: s.payloadHash, o: r.orderIndex}) AS O }
CALL { WITH new OPTIONAL MATCH (new)-[r:HAS_PROTOCOL_STEP]->(s:ProtocolStep) RETURN collect({k: s.stepKey, h: s.payloadHash, o: r.orderIndex}) AS N }
WITH old, new, oldCapture, newCapture, O, N, any(c IN oldCapture WHERE c <> 'COMPLETE') AS oldPartial, any(c IN newCapture WHERE c <> 'COMPLETE') AS newPartial
UNWIND [x IN O | x.k] + [x IN N | x.k] AS stepKey
WITH DISTINCT old, new, oldPartial, newPartial, stepKey, head([x IN O WHERE x.k = stepKey]) AS o, head([x IN N WHERE x.k = stepKey]) AS n
RETURN stepKey,
       CASE WHEN o IS NULL AND oldPartial THEN 'ADDED_OR_NOT_CAPTURED' WHEN o IS NULL THEN 'ADDED'
            WHEN n IS NULL AND newPartial THEN 'REMOVED_OR_NOT_CAPTURED' WHEN n IS NULL THEN 'REMOVED'
            WHEN o.h = n.h THEN 'UNCHANGED' ELSE 'MODIFIED' END AS changeKind,
       o.o AS oldOrder, n.o AS newOrder, (o IS NOT NULL AND n IS NOT NULL AND o.o <> n.o) AS reordered,
       new.changeProvenance AS changeProvenance, old.editionLabel AS oldLabel, new.editionLabel AS newLabel
ORDER BY stepKey;
