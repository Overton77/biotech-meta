MATCH (a:ProtocolEdition {uid: 'hu:protocol-edition:synthetic-floating-parent-e1'}), (b:Protocol {uid: 'hu:protocol:protocolsio-pbmc-cpt'}) MERGE (a)-[r:HAS_SUBPROTOCOL]->(b) SET r += {orderIndex: 2};

// Q-W16-13: which subprotocol edition does each parent include at a valid-time instant V (2021-06-01 and 2023-06-01)? PINNED is fixed; FLOATING is resolved as-of
// with the QS-2b validity classes and labelled RESOLVED_AS_OF.
UNWIND [datetime('2021-06-01T00:00:00Z'), datetime('2023-06-01T00:00:00Z')] AS V
MATCH (pe:ProtocolEdition) WHERE pe.uid IN ['hu:protocol-edition:synthetic-pinned-parent-e1', 'hu:protocol-edition:synthetic-floating-parent-e1']
OPTIONAL MATCH (pe)-[:INCLUDES_PROTOCOL]->(pinned:ProtocolEdition)
OPTIONAL MATCH (pe)-[:HAS_SUBPROTOCOL]->(sp:Protocol)-[h:HAS_PROTOCOL_EDITION]->(fe:ProtocolEdition)
WHERE h.recordedTo IS NULL AND (h.validFrom IS NULL OR h.validFrom <= V) AND (h.validTo IS NULL OR V < h.validTo)
RETURN pe.uid AS parentEdition, toString(date(V)) AS validAt,
       CASE WHEN pinned IS NOT NULL THEN 'PINNED' WHEN fe IS NOT NULL THEN 'RESOLVED_AS_OF' ELSE 'UNRESOLVED' END AS binding,
       coalesce(pinned.editionLabel, fe.editionLabel) AS includedEdition,
       CASE WHEN fe IS NOT NULL AND h.validTo IS NULL THEN 'OPEN_END_UNVERIFIED' WHEN fe IS NOT NULL THEN 'KNOWN_WITHIN' END AS validityClass
ORDER BY parentEdition, validAt;
