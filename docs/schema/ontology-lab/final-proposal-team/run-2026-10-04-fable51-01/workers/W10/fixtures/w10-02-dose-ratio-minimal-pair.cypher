MATCH (act:Activity {uid: 'hu:activity:w10-applicability-review-2026-10-04'}), (ea:EvidenceApplicability {uid: 'hu:applicability:w10-nct02712593-300-to-tru-niagen-300-v2'})
MERGE (ea)-[:WAS_GENERATED_BY]->(act);

